{
	"source": {
    "include": ["./src"],
    "excludePattern": "./src/(index|d3)\\.js$"
  },
	"tags": {
		"allowUnknownTags" : true
	},
	"plugins": ["plugins/markdown"],
	"templates": {
		"cleverLinks": true,
		"monospaceLinks": true,
		"default": {
			"outputSourceFiles" : true
		},
		"applicationName": "CGView.js",
		"disqus": "",
		"googleAnalytics": "",
		"openGraph": {
			"title": "",
			"type": "website",
			"image": "",
			"site_name": "",
			"url": ""
		},
		"meta": {
			"title": "CGView.js",
			"description": "",
			"keyword": ""
		},
		"linenums": false
	},
	"markdown": {
		"parser": "gfm",
		"hardwrap": false,
    "breaks": false,
		"tags": ["examples"]
	},
  "docset": {
    "name": "CGView",
    "icon": "docs/images/logo.png",
    "enableJavascript": true
  }
}
